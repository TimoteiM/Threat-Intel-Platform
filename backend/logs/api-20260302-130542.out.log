                    COUNT(*) AS count
                FROM evidence e
                JOIN investigations i ON i.id = e.investigation_id
                WHERE i.classification = ANY($3)
                  AND i.state = 'concluded'
                  AND e.evidence_json->$1->>$2 IS NOT NULL
                  AND e.evidence_json->$1->>$2 != ''
                GROUP BY field_value
                ORDER BY count DESC
                LIMIT $4
            
