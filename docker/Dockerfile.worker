FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev whois && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright's bundled Chromium + OS dependencies
RUN playwright install chromium --with-deps

COPY . .

# Patch anyrun-sdk: fix file upload bug where json=params is silently ignored by requests
# when files= is also provided, causing task parameters to be dropped and the API to return
# an empty response (SDK null payload error).
RUN python scripts/patch_anyrun_sdk.py

CMD ["celery", "-A", "app.tasks.celery_app", "worker", "--loglevel=info", "--concurrency=4"]
